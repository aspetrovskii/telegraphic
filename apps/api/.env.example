# Telegraphic API — environment

PORT=8787

# SQLite (local) — default if Turso is unset
DATABASE_URL=file:./data/dev.db

# Turso (production / preview)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Cookie Secure flag (set in production; also implied by NODE_ENV=production)
# COOKIE_SECURE=1
