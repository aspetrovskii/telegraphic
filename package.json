{
  "name": "telegraphic",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Telegram Desktop chat exports → customizable bar-chart-race videos",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @telegraphic/web --filter @telegraphic/api dev",
    "build": "pnpm -r --filter @telegraphic/shared --filter @telegraphic/api --filter @telegraphic/web build && node scripts/bundle-api.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "bundle:api": "node scripts/bundle-api.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "@types/node": "^22.16.5",
    "@types/react-router-dom": "^5.3.3",
    "esbuild": "^0.25.8",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
